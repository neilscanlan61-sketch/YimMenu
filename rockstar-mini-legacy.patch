+# YimMenuV2 click theme v1; RGBA values are 0..1
+# Rojo animation-ready adaptation for Rockstar Tool compact-click build.
+Background 0.0784313725 0.0784313725 0.0901960784 0.941176471
+Surface 0 0 0 0.639215686
+Accent 0.862745098 0.176470588 0.176470588 1
+Selection 0.862745098 0.176470588 0.196078431 0.392156863
+Text 0.941176471 0.941176471 0.941176471 1
+Muted 0.549019608 0.549019608 0.549019608 1
+Border 0.862745098 0.176470588 0.196078431 0.705882353
+Header 0.396078431 0.0196078431 0.0196078431 0.717647059
+BackgroundLow 0.274509804 0.0980392157 0.0980392157 0.823529412
+Button 0.0901960784 0.0901960784 0.0901960784 1
+ButtonHover 0.862745098 0.176470588 0.196078431 0.588235294
+Width 640
+Height 500
+RowHeight 44
+Rounding 8
+PlayerWidth 160
+Scanlines 0
+BackgroundEnabled 1
+BackgroundOpacity 0.25
+BackgroundSpeed 1
+LightIntensity 0.18
